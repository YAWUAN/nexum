# ============================================================
# Nexum — contoh konfigurasi. SALIN file ini menjadi .env.local
# lalu isi nilainya. JANGAN menaruh key asli di file ini.
#   Windows CMD:  copy .env.example .env.local
# ============================================================

# Pilih provider: "google" atau "anthropic"
AI_PROVIDER=google

# --- Jika AI_PROVIDER=google ---
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# --- Jika AI_PROVIDER=anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Email kontak yang tampil di halaman kontak & terminal
NEXT_PUBLIC_CONTACT_EMAIL=emailmu@gmail.com
